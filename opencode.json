{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-max",
  "default_agent": "build",
  "agents": {
    "build": {
      "model": "opencode/deepseek-v4-flash-max",
      "description": "Primary coding agent for complex reasoning and multi-file changes"
    },
    "plan": {
      "model": "opencode/qwen-3.7-max",
      "description": "Architectural planning and system design"
    },
    "fast-edit": {
      "model": "opencode/deepseek-v4-flash",
      "description": "Quick inline fixes, single-file edits, and docstrings"
    },
    "reviewer": {
      "model": "opencode/minimax-m3",
      "description": "Lightweight code review and sanity checks",
      "mode": "subagent"
    }
  },
  "instructions": [
    ".github/instructions/FRONTEND_GUIDELINE.md",
    "docs/frontend/testing.md"
  ]
}
